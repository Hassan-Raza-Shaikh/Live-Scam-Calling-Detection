# Sentinel AI Environment Configuration Template

# General App Settings
PROJECT_NAME="Sentinel AI"
ENVIRONMENT="development" # development | staging | production
LOG_LEVEL="INFO"

# API & WebSocket Server
API_HOST="0.0.0.0"
API_PORT=8000
WS_PORT=8000
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# AI / LLM Provider Credentials
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_PROVIDER="openai" # openai | anthropic | gemini | local
DEFAULT_MODEL_NAME="gpt-4o-mini"

# Local LLM / Ollama Configuration (Fallback/Edge)
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_MODEL_NAME="llama3.2:3b"

# Audio Engine Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
VAD_THRESHOLD=0.5
WHISPER_MODEL_SIZE="base.en" # tiny.en | base.en | small.en | medium.en
ENABLE_SPEAKER_DIARIZATION=true

# Database & Vector Store
DATABASE_URL="sqlite:///./sentinel.db"
CHROMA_DB_PATH="./knowledge/vector_store"

# Security & Alerting Thresholds
FAST_PATH_ALERT_THRESHOLD=0.85
SCAM_RISK_HIGH_THRESHOLD=0.75
SCAM_RISK_MEDIUM_THRESHOLD=0.45
